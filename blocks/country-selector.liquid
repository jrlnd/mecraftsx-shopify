{%- doc -%}
  Renders a dropdown country/region selector that switches the store's market and currency.
  Shows nothing when the store sells to a single country. The list opens upward, so the block
  suits the bottom of the page, such as the footer utilities bar.
{%- enddoc -%}

{% if localization.available_countries.size > 1 %}
  {% render 'dropdown-localization-styles' %}

  {% liquid
    assign block_settings = block.settings
    assign localization_font = '--menu-localization-font: var(--font-[font]--family); ' | replace: '[font]', block_settings.font
    assign localization_font_size = '--menu-localization-font-size: [size]; ' | replace: '[size]', block_settings.font_size
    assign form_style = localization_font | append: localization_font_size | append: '--color-shadow: rgb(var(--color-foreground-rgb) / var(--opacity-10-25));'
    assign panel_id = 'CountrySelector-' | append: block.id
  %}

  <dropdown-localization-component
    class="dropdown-localization country-selector spacing-style"
    style="{% render 'spacing-padding', settings: block_settings %}"
    {{ block.shopify_attributes }}
  >
    <button
      type="button"
      class="button dropdown-localization__button localization-selector"
      aria-expanded="false"
      aria-controls="{{ panel_id }}"
      ref="button"
      on:click="/toggleSelector"
      style="{{ localization_font }} {{ localization_font_size }}"
    >
      {% if block_settings.show_flag %}
        <span
          class="icon-flag"
          style="
            background-image: url({{- localization.country | image_url: width: 32 }});
            --size-shadow: 2px;
            --color-shadow: rgb(var(--color-foreground-rgb) / var(--opacity-30-60));
          "
        ></span>
      {% endif %}
      <span class="currency-code">
        {{- localization.country.currency.iso_code -}}
      </span>
      <span class="visually-hidden">
        {{- 'accessibility.localization_region_and_language' | t -}}
      </span>
      <span class="svg-wrapper icon-caret">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </button>

    <div
      id="{{ panel_id }}"
      class="localization-wrapper localization-wrapper--up left-bound color-custom-popover"
      hidden
      ref="panel"
    >
      {% render 'localization-form',
        show_country: true,
        show_language: false,
        show_flags: block_settings.show_flag,
        pinned_countries: block_settings.pinned_countries,
        localization_style: 'dropdown',
        form_style: form_style,
        form_id: block.id
      %}
    </div>
  </dropdown-localization-component>
{% endif %}

{% stylesheet %}
  /* Every country shows its currency, not just the hovered or selected one. */
  .country-selector .localization-form__currency {
    opacity: 1;
    visibility: visible;
    color: var(--color-foreground-muted);
  }

  .country-selector .dropdown-localization__button {
    min-height: 0;
    padding-block: var(--padding-2xs);
    color: inherit;
  }

  /* The block spans the stacked footer bar on mobile, so center the list and keep it on screen. */
  @media screen and (max-width: 749px) {
    .country-selector {
      display: flex;
      justify-content: center;
      width: 100%;
    }

    .country-selector .localization-wrapper.localization-wrapper--up {
      inset-inline: 0;
      width: min(26rem, calc(100vw - (2 * var(--page-margin, 16px))));
      margin-inline: auto;
    }

    .country-selector .localization-form {
      max-width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.country_selector",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:info.manage_countries_regions"
    },
    {
      "type": "text",
      "id": "pinned_countries",
      "label": "t:settings.pinned_countries",
      "info": "t:info.pinned_countries",
      "default": "US,CA"
    },
    {
      "type": "checkbox",
      "id": "show_flag",
      "label": "t:settings.flag",
      "default": true
    },
    {
      "type": "select",
      "id": "font",
      "label": "t:settings.font",
      "options": [
        {
          "value": "heading",
          "label": "t:options.heading"
        },
        {
          "value": "subheading",
          "label": "t:options.subheading"
        },
        {
          "value": "body",
          "label": "t:options.body"
        },
        {
          "value": "accent",
          "label": "t:options.accent"
        }
      ],
      "default": "body"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "0.625rem",
          "label": "10px"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        }
      ],
      "default": "0.75rem"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.country_selector",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
