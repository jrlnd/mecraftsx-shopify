{% comment %}
  Section contract.
  Shows the first few posts of an Instagram feed app block as an even grid of square tiles
  under an optional heading. The section owns columns, gap, and corners; the app owns the posts. The app block's own wrappers are flattened with `display: contents`, so the
  CSS below is coupled to the Instafeed markup (`.instafeed-shoppable__*`). Recheck it after
  changing the feed style or app version.
  Posts are plain links to Instagram, not the app's popup: the inline script reads each post's
  permalink from the app's feed response and overlays an anchor on its tile.
  @example
  <!-- Add "Instagram feed" in the theme editor, then add the Instafeed app block inside it -->
{% endcomment %}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign posts = section.settings.posts
  assign hidden_from = posts | plus: 1
%}

<div
  class="
    section-background
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
  "
></div>

<script>
  /* Instagram feed: link tiles straight to Instagram instead of the app's popup.
     Runs before the app loads so it can read the feed response it fetches. */
  (() => {
    const sectionId = {{ section.id | json }};
    const fallbackLabel = {{ 'instagram_feed.view_post' | t | json }};
    const permalinks = new Map();

    const linkTiles = () => {
      const root = document.getElementById('shopify-section-' + sectionId);
      if (!root) return;

      for (const card of root.querySelectorAll('.instafeed-shoppable__card[data-instafeed-post-id]')) {
        const href = permalinks.get(card.dataset.instafeedPostId);
        const frame = card.querySelector('.instafeed-shoppable__frame');
        if (!href || !frame || frame.querySelector('.instagram-feed__link')) continue;

        const media = frame.querySelector('.instafeed-shoppable__media');
        const link = document.createElement('a');
        link.className = 'instagram-feed__link';
        link.href = href;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.setAttribute('aria-label', media?.getAttribute('aria-label') || fallbackLabel);
        frame.append(link);

        // The tile's own button would open the popup, so take it out of the way.
        media?.setAttribute('tabindex', '-1');
        media?.setAttribute('aria-hidden', 'true');
      }
    };

    const nativeFetch = window.fetch;
    window.fetch = function (...args) {
      const response = nativeFetch.apply(this, args);
      const url = String(args[0]?.url ?? args[0]);

      if (url.includes('api.nfcube.com/feed/')) {
        response
          .then((result) => result.clone().json())
          .then((feed) => {
            for (const post of feed.data ?? []) permalinks.set(String(post.id), post.link);
            linkTiles();
          })
          .catch(() => {});
      }

      return response;
    };

    document.addEventListener('DOMContentLoaded', () => {
      const root = document.getElementById('shopify-section-' + sectionId);
      if (root) new MutationObserver(linkTiles).observe(root, { childList: true, subtree: true });
    });
  })();
</script>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    instagram-feed
    spacing-style
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
  "
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="instagram-feed__inner">
    {% content_for 'block', type: 'group', id: 'instagram-feed-header' %}

    <div
      class="instagram-feed__grid"
      style="
        --instagram-feed-columns: {{ posts }};
        --instagram-feed-gap: {{ section.settings.gap }}px;
        --instagram-feed-radius: {{ section.settings.corner_radius }}px;
      "
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% style %}
  /* The app lazy-loads more posts than the grid shows; hide the extras. */
  #shopify-section-{{ section.id }} .instafeed-shoppable__card:nth-child(n + {{ hidden_from }}) {
    display: none !important;
  }
{% endstyle %}

{% stylesheet %}
  .instagram-feed__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--instagram-feed-gap, 12px);
  }

  .instagram-feed__inner {
    display: flex;
    flex-direction: column;
    gap: var(--padding-4xl);
    min-width: 0;
  }

  .instagram-feed__inner > .group-block:not(:has(.group-block-content > *)) {
    display: none;
  }

  /* Flatten the app's wrappers so its posts become direct items of the section grid. */
  .instagram-feed__grid .shopify-app-block,
  .instagram-feed__grid #insta-feed,
  .instagram-feed__grid .instafeed-shoppable,
  .instagram-feed__grid .instafeed-shoppable__scroller,
  .instagram-feed__grid .instafeed-shoppable__track {
    display: contents;
  }

  .instagram-feed__grid .instafeed-shoppable__nav {
    display: none !important;
  }

  /* The app sets its post ratio inline on the feed root, so only !important can win. */
  .instagram-feed__grid .instafeed-shoppable {
    --instafeed-shoppable-ratio: 1 !important;
  }

  .instagram-feed__grid .instafeed-shoppable__card {
    width: auto;
    min-width: 0;
  }

  .instagram-feed__grid .instafeed-shoppable__frame {
    aspect-ratio: 1 !important;
    border: 0;
    border-radius: var(--instagram-feed-radius, 10px);
    box-shadow: none;
  }

  /* Tiles are links to Instagram, with no hover lift, shadow, or zoom. */
  .instagram-feed__grid .instafeed-shoppable__frame {
    position: relative;
  }

  .instagram-feed__link {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }

  .instagram-feed__link:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: -2px;
  }

  .instagram-feed__grid .instafeed-shoppable__media {
    pointer-events: none;
  }

  .instagram-feed__grid .instafeed-shoppable__card:hover .instafeed-shoppable__frame {
    transform: none !important;
    box-shadow: none !important;
    border-color: transparent !important;
  }

  .instagram-feed__grid .instafeed-shoppable__card:hover .instafeed-shoppable__post-image {
    transform: none !important;
  }

  @media screen and (min-width: 750px) {
    .instagram-feed__grid {
      grid-template-columns: repeat(var(--instagram-feed-columns, 5), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.instagram_feed",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "posts",
      "label": "t:settings.posts",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background",
      "alpha": true
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "t:names.instagram_feed",
      "category": "t:categories.layout",
      "blocks": {
        "instagram-feed-header": {
          "type": "group",
          "static": true,
          "settings": {
            "horizontal_alignment_flex_direction_column": "center",
            "gap": 10
          },
          "blocks": {
            "heading": {
              "type": "text",
              "settings": {
                "text": "<h2>Follow along</h2>",
                "type_preset": "h2",
                "width": "100%",
                "alignment": "center"
              }
            },
            "intro": {
              "type": "text",
              "settings": {
                "text": "<p>@me_craftsx on Instagram</p>",
                "width": "100%",
                "alignment": "center"
              }
            }
          },
          "block_order": ["heading", "intro"]
        }
      }
    }
  ]
}
{% endschema %}
