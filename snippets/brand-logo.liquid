{%- doc -%}
  Renders the ME Crafts logo (mecrafts-logo.svg) inline. Used where no logo image is uploaded in
  theme settings. The lettering follows the surrounding text color; the hearts use
  `--brand-logo-accent-color`.

  @param {string} [class] - Additional classes for the svg element.
  @param {string} [style] - Inline styles for the svg element.
  @param {string} [label] - Accessible name. When blank the logo is decorative.

  @example
  {% render 'brand-logo', class: 'header-logo__svg', label: shop.name %}
{%- enddoc -%}

