{%- doc -%}
  Shared product recommendations styles used by the section and block.

  @example
  {% render 'product-recommendations-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .product-recommendations {
    display: block;
  }

  .product-recommendations__skeleton-item {
    aspect-ratio: 3 / 4;
    background-color: var(--color-foreground);
    opacity: var(--skeleton-opacity);
    border-radius: 4px;
  }

  @media screen and (max-width: 749px) {
    .product-recommendations__skeleton-item:nth-child(2n + 1) {
      display: none;
    }
  }

  /* Optional inset panel behind the heading and cards. The section's own grid row-gap moves inside it. */
  .product-recommendations__panel {
    display: grid;
    row-gap: var(--gap);
    min-width: 0;
    padding: var(--padding-5xl) var(--padding-3xl);
    border-radius: var(--product-recommendations-panel-radius);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  @media screen and (max-width: 749px) {
    .product-recommendations__panel {
      padding-inline: var(--padding-lg);
    }
  }

  product-recommendations:has([data-has-recommendations='false']) {
    display: none;
  }
{% endstylesheet %}
