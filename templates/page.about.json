                "max_width": "none",
                "alignment": "center",
                "text_color": "#5A3A24"
              }
            },
            "together": {
              "type": "text",
              "settings": {
                "text": "<p>Together, we’re ME!</p>",
                "type_preset": "custom",
                "width": "100%",
                "max_width": "none",
                "alignment": "center",
                "text_color": "#B8513C",
                "font": "var(--font-accent--family)",
                "font_size": "2.5rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty"
              }
            },
            "heart_divider": {
              "type": "group",
              "settings": {
                "content_direction": "column",
                "horizontal_alignment_flex_direction_column": "center",
                "width": "fill"
              },
              "blocks": {
